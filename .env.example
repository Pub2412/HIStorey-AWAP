# Mailtrap example (recommended for testing email locally)
# Sign up at https://mailtrap.io and use the SMTP credentials provided for your inbox
MAILTRAP_HOST=smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=your_mailtrap_user
MAILTRAP_PASS=your_mailtrap_pass

# App
PORT=3000

# MySQL database (import database/hstore_db.sql first)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hstore_db
DB_USER=root
DB_PASSWORD=

# JWT auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d